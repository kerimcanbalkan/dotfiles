#show-read-feeds no
auto-reload yes

bind-key j down
bind-key k up
bind-key j next articlelist
bind-key k prev articlelist
bind-key J next-feed articlelist
bind-key K prev-feed articlelist
bind-key G end
bind-key g home
bind-key d pagedown
bind-key u pageup
bind-key l open
bind-key h quit
bind-key a toggle-article-read
bind-key n next-unread
bind-key p prev-unread
bind-key D pb-download
bind-key U show-urls
bind-key x pb-delete

color background         white     black
color listnormal         color246  black
color listfocus          black     yellow  bold
color listnormal_unread  blue      black
color listfocus_unread   black     yellow  bold
color info               color234  color246 bold
color article            white     black

highlight all "---.*---" color215
highlight feedlist ".*(0/0))" color242
highlight article "(^Feed:.*|^Author:.*)" cyan black bold
highlight article "^Title:.*$" color215 black bold
highlight article "(^Link:.*|^Date:.*)" color246 black
highlight article "https?://[^ ]+" green black
highlight article "\\[[0-9][0-9]*\\]" magenta black bold
highlight article "\\[image\\ [0-9]+\\]" cyan black bold
highlight article "\\[embedded flash: [0-9][0-9]*\\]" cyan black bold
highlight article ":.*\\(link\\)$" green black
highlight article ":.*\\(image\\)$" cyan black
highlight article ":.*\\(embedded flash\\)$" magenta black

browser linkhandler
macro , open-in-browser
